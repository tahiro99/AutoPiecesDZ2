{
  "expo": {
    "name": "AutoPiecesDZ2",
    "slug": "AutoPiecesDZ2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090B"
    },
    "scheme": "autopieces",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autopieces.dz",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.268280059559-tusji4fgedrtldviu507b0fdv3io5lt4"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.autopieces.dz",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#08090B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "enableCoreLibraryDesugaring": true
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBAuth", "RNFBMessaging"]
          }
        }
      ],
      "./plugins/withCoreLibraryDesugaring",
      "./plugins/withFirebaseAuthAPNS"
    ],
    "extra": {
      "eas": {
        "projectId": "904f8e86-1d8a-4d28-9bd8-b9ad31535e84"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/904f8e86-1d8a-4d28-9bd8-b9ad31535e84"
    }
  }
}